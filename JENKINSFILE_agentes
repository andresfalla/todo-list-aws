pipeline {
    agent none

    stages {

        stage('Get Code') {
            agent { label 'principal' }
            steps {
                sh 'whoami'
                sh 'hostname'

                git branch: 'develop',
                    url: 'https://github.com/andresfalla/todo-list-aws.git'

                stash name: 'workspace', includes: '**'
            }
        }

        stage('Static Test') {
            agent { label 'static' }
            steps {
                bat "whoami"
                bat "hostname"

                unstash 'workspace'

                bat """
                    mkdir reports
                    flake8 src --output-file=reports/flake8.txt
                    bandit -r src -f html -o reports/bandit.html
                """
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/flake8.txt', fingerprint: true
                    publishHTML(target: [
                        reportDir: 'reports',
                        reportFiles: 'bandit.html',
                        reportName: 'Bandit Report'
                    ])
                }
            }
        }

        stage('Deploy') {
            agent { label 'principal' }
            steps {
                sh 'whoami'
                sh 'hostname'

                unstash 'workspace'

                sh '''
                    sam build
                    sam validate
                    sam deploy \
                        --stack-name staging-todo-list-aws \
                        --resolve-s3 \
                        --no-confirm-changeset \
                        --no-fail-on-empty-changeset \
                        --capabilities CAPABILITY_IAM \
                        --parameter-overrides StageName=staging
                '''

                sh '''
                    aws cloudformation describe-stacks \
                        --stack-name staging-todo-list-aws \
                        --query "Stacks[0].Outputs[?OutputKey=='BaseUrlApi'].OutputValue" \
                        --output text > api.txt
                '''

                stash name: 'api', includes: 'api.txt'
                stash name: 'workspace', includes: '**'
            }
        }

        stage('Rest Test') {
            agent { label 'rest' }
            steps {
                bat "whoami"
                bat "hostname"

                unstash 'workspace'
                unstash 'api'

                script {
                    env.BASE_URL = readFile('api.txt').trim()
                }

                bat """
                    echo BASE_URL=%BASE_URL%
                    set BASE_URL=%BASE_URL%
                    pytest test/integration --junitxml=result-rest.xml
                """
            }
            post {
                always {
                    junit 'result-rest.xml'
                }
            }
        }

        stage('Promote') {
            when {
                branch 'develop'
            }
            agent { label 'principal' }
            steps {
                sh 'whoami'
                sh 'hostname'

                unstash 'workspace'

                withCredentials([usernamePassword(credentialsId: 'github-token', usernameVariable: 'USER', passwordVariable: 'TOKEN')]) {
                    sh '''
                        git config user.email "jenkins@local"
                        git config user.name "Jenkins CI"

                        git checkout master
                        git merge develop --no-edit

                        git push https://$USER:$TOKEN@github.com/andresfalla/todo-list-aws.git master
                    '''
                }
            }
        }

    }
}